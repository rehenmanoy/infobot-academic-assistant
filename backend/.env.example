# Copy to .env and fill in. Never commit the real .env.

APP_ENV=development

# SQLite works out of the box for local development.
# MySQL example: mysql+pymysql://infobot:password@localhost:3306/infobot?charset=utf8mb4
DATABASE_URL=sqlite:///./infobot.db

# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Optional: created on startup if no admin account exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: enables the InfoBot chat assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
